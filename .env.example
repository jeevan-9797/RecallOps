# ==============================================================================
# RecallOps - Environment Configuration
# Member 3: Database & Data Engineering
# ==============================================================================

# Local PostgreSQL Docker Container Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=recallops
POSTGRES_PORT=5432

# Master PostgreSQL Connection String
# Matches database/connection.py expectations:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/recallops

# Database Connection Pool Tuning (Optional overrides)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Hindsight Cloud Memory Engine Settings
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=kartly-sre

# Data Pipeline Settings
SEED_RANDOM_SEED=42
ENVIRONMENT=development
LOG_LEVEL=INFO
