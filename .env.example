# ==============================================================================
# RecallOps Environment Configuration
# ==============================================================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Target LLM Models for Evaluation & Inference
PRIMARY_MODEL=openai/gpt-oss-120b
SECONDARY_MODEL=qwen/qwen3-32b

# Hindsight Cloud Configuration (Phase 1)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_ENDPOINT=https://api.hindsight.cloud/v1
HINDSIGHT_WORKSPACE_ID=recallops-hackathon

# Logging & Debug
LOG_LEVEL=INFO
DEBUG_MODE=false
