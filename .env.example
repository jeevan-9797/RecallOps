# ==============================================================================
# RecallOps Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG_MODE=false
LOG_LEVEL=INFO
PORT=8000

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=openai/gpt-oss-120b
SECONDARY_MODEL=qwen/qwen3-32b

# Hindsight Cloud Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_ENDPOINT=https://api.hindsight.cloud/v1
HINDSIGHT_BANK_ID=kartly-sre

# PostgreSQL Database (Local Docker or Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recallops

# Hosted Supabase Integration (Optional for local development)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Band Multi-Agent Room Integration (Pending Research Lead verification)
BAND_ROOM_WEBHOOK_URL=http://localhost:5000/webhook

# Frontend CORS Allowed Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
